{
  // JSON5 test fixture — exercises the relaxed syntax from spec.json5.org
  // Single-line comment at top
  /* Block comment
     spanning multiple lines */

  // Unquoted keys (valid ES5 identifiers)
  unquoted: "value",
  _underscore: "ok",
  $dollar: "ok",

  // Single-quoted strings
  singleQuotes: 'single',
  nestedQuotes: 'contains "double" quotes',

  // Comments inside strings MUST NOT be stripped
  commentInString: "this is // not a comment",
  blockInString: "this is /* not a comment */",

  // Trailing commas
  trailingArray: [1, 2, 3,],
  trailingObject: {
    a: 1,
    b: 2,
  },

  // Hexadecimal numbers
  hex: 0xFF,
  hex2: 0xDEADBEEF,

  // Leading and trailing decimal points
  leading: .5,
  trailing: 5.,

  // Explicit plus sign
  positive: +42,

  // Scientific notation (valid in strict JSON too)
  scientific: 1e3,
  scientificNeg: 1.5E-10,

  // IEEE 754 special values
  infinity: Infinity,
  negativeInfinity: -Infinity,
  nan: NaN,

  // Multi-line string with backslash continuation
  multiline: "line 1 \
line 2 \
line 3",

  // Unicode escapes and surrogate pair (emoji)
  unicode: "\u0048\u0065\u006C\u006C\u006F",
  emoji: "\uD83D\uDE00",

  // Large number exceeding Number.MAX_SAFE_INTEGER (precision loss expected)
  largeNumber: 9007199254740993,

  // Deeply nested structure
  nested: {
    level1: {
      level2: {
        level3: {
          level4: {
            level5: { data: [1, 2, 3, 4, 5] }
          }
        }
      }
    }
  },

  // Duplicate keys (JSON5/JSON take last value per spec)
  duplicate: "first",
  duplicate: "second",

  // Empty array and empty object
  emptyArray: [],
  emptyObject: {},
}
